{
	// ============================================================
	// AIEmpires Star Map (InnerSphereMap fork) — settings
	// Edit values, save, and restart the game. No cache clearing
	// is needed for settings-only changes.
	// ============================================================

	// ---- Camera & zoom ------------------------------------------
	// MinFov = how far you can zoom IN (smaller = closer).
	// MaxFov = how far you can zoom OUT (bigger = wider view).
	"MinFov": 15.0,
	"MaxFov": 150.0,
	// Map canvas half-size in world units, plus edge padding. If you
	// grow the canvas, grow CameraDistance proportionally too.
	"MapWidth": 400.0,
	"MapHeight": 400.0,
	"MapTopViewBuffer": 25.0,
	"MapLeftViewBuffer": 25.0,
	"MapRightViewBuffer": 25.0,
	"MapBottomViewBuffer": 75.0,
	// legacy flag from the BTA lineage, leave as-is
	"use3040Map": true,

	// ---- Political map (colored territories) --------------------
	// drawBorders paints faction-colored territory regions.
	// rescaleBorders stretches that painting to the whole canvas.
	// borderFillWhite keeps the fill visible (false = broken/black).
	// TravelWashIntensity: 0 disables the white "reachable space"
	// overlay (with an open map it just greys everything); -1 = vanilla.
	"drawBorders": true,
	"rescaleBorders": true,
	"borderFillWhite": true,
	"TravelWashIntensity": 0.0,

	// ---- Faction crests (the logo icons over each territory) ----
	// logoTintByFaction colors the white crest art with each
	// faction's map color. LogoOpacity = crest transparency.
	"logoTintByFaction": true,
	"LogoOpacity": 0.45,
	// Crest size scales with how big the faction's territory is:
	// extent * LogoExtentFactor, clamped between Min and Max.
	// LogoExtentFactor 0 = fixed size for everyone.
	"LogoExtentFactor": 0.022,
	"LogoMinScaleAdd": 0.8,
	"LogoMaxScaleAdd": 4.0,
	// Hide crests for factions whose territory is smaller than this
	// (0 = show everyone, even the Kerensky cluster micro-clans).
	"LogoMinExtentToShow": 0.0,
	// Extra size multiplier for Clan crests only (0.5 = half size).
	"ClanLogoScaleMult": 0.5,
	// If a Clan invasion is underway and this is true, only the
	// leading invader Clan gets a crest instead of every Clan.
	"reducedClanLogos": false,

	// ---- Faction names (text under each crest) ------------------
	// Size is in crest-local units; 0 hides the names entirely.
	"FactionNameSize": 0.012,
	"FactionNameOpacity": 0.28,
	"FactionNameBrightness": 0.65,

	// ---- System name labels (zoomed-in layer) -------------------
	// JumpLabelDepth: label every system within this many jumps of
	// your current position (0 = off).
	"JumpLabelDepth": 2,
	// ShowLabelDifficulty: skull row under each labeled system name.
	"ShowLabelDifficulty": true,
	// Size / transparency / dimness of system name labels.
	"LabelCharacterSize": 0.038,
	"LabelOpacity": 0.4,
	"LabelBrightness": 0.75,
	// Alternative label mode: name systems near the CAMERA center as
	// you pan (world units, 0 = off). Works alongside JumpLabelDepth.
	"ViewLabelRadius": 0.0,

	// ---- Famous worlds (always labeled, in gold) ----------------
	// Names must match the in-game system name exactly.
	"alwaysLabeledSystems": [
		"Terra", "Tukayyid", "Solaris", "Outreach", "Northwind",
		"Hesperus II", "Kentares IV", "Misery", "Wolcott", "Turtle Bay",
		"Twycross", "Coventry", "Tikonov", "Sarna", "Kathil",
		"New Syrtis", "Robinson", "Dieron", "Proserpina", "Skye",
		"Alshain", "Huntress", "Strana Mechty", "Galatea", "Tharkad",
		"Luthien", "New Avalon", "Sian", "Atreus (FWL)", "Rasalhague",
		"Taurus", "Canopus IV", "Alpheratz", "Oberon VI", "Circinus",
		"St. Ives", "Alphard (MH)", "Galedon V", "Benjamin"
	],

	// ---- New-career splash screen -------------------------------
	"splashTitle": "AI<color=#daa520>Empires</color>",
	"splashText": "<b>The Inner Sphere is thinking.</b> \n\n Welcome, Commander!\n\n The full Inner Sphere and Periphery lay before you — over 3,000 star systems, with every Great House and Periphery power played by its own AI leader making real strategic decisions. \n\n This map is alive. Wars will start without you. Borders will move whether you fight or not. \n\n <b><color=#daa520>Find your place in it, and make your mark on the Inner Sphere!</color></b>",
